{
  "schema_version": "raes-screening-validation-config/1",
  "status": "draft_not_executable",
  "live_enabled": false,
  "snapshot": "{{SEARCH_SNAPSHOT_ID}}",
  "screening_rules_version": "{{RULES_VERSION}}",
  "audit_codebook": {
    "path": "validation/screening/codebook.json",
    "sha256": "{{SHA256}}"
  },
  "eligibility_sha256": "{{SHA256}}",
  "order": ["full_text", "abstract"],
  "full_text": {
    "frame": {
      "path": "{{FROZEN_FULL_TEXT_EXCLUSIONS}}",
      "sha256": "{{SHA256}}",
      "size": null
    },
    "strata": {
      "near_miss": "{{DEFINITION, e.g. failed exactly one criterion}}",
      "other": "{{DEFINITION}}"
    },
    "sample": {
      "round_size": null,
      "allocation": "{{BY_STRATUM}}",
      "seed": null
    },
    "reviewers": {
      "auditor_1": {"provider": "{{PROVIDER}}", "model_snapshot": "{{EXACT_MODEL_ID}}", "settings": {}},
      "auditor_2": {"provider": "{{DIFFERENT_PROVIDER}}", "model_snapshot": "{{EXACT_MODEL_ID}}", "settings": {}},
      "third": {"provider": "{{THIRD_PROVIDER}}", "model_snapshot": "{{EXACT_MODEL_ID}}", "settings": {}}
    },
    "routing": "auditor_1 and auditor_2 independently; third only when both answers are valid and disagree; majority by code; human adjudication only when the majority says include",
    "stopping_rule": "{{APPROVED_RULE}}"
  },
  "abstract": {
    "frame": {
      "path": "{{FROZEN_ABSTRACT_EXCLUSIONS}}",
      "sha256": "{{SHA256}}",
      "size": null
    },
    "strata": "search batches",
    "sample": {
      "round_size": null,
      "allocation": "proportional to stratum size",
      "seed": null
    },
    "reviewers": {
      "auditor": {"provider": "{{PROVIDER}}", "model_snapshot": "{{EXACT_MODEL_ID}}", "settings": {}}
    },
    "candidate_route": "retrieve the full text; run the frozen full-text screen; if it includes the record, review it with the full_text reviewers above",
    "stopping_rule": "a round with no candidate passing the frozen full-text screen ends the audit; rounds in which candidates pass but the reviewers exclude all of them count toward a cumulative total of {{K}}; a confirmed miss is added back and the audit continues; every {{M}}th confirmed miss triggers a review for systematic failure"
  },
  "rule_change": "rules stay fixed during an audit; a change is a new version, the current run is archived and a fresh sample is frozen",
  "payload_policy": {
    "program_decision_hidden": true,
    "other_answers_hidden": true,
    "downstream_results_hidden": true,
    "source_text_is_untrusted_data": true
  },
  "retries": {
    "max_new_attempts_per_invocation": null,
    "resume_global_attempt_ids": true,
    "technical_failure_is_not_a_decision": true,
    "request_identity_unchanged": true
  },
  "budget": {
    "currency": "USD",
    "approved_max": null,
    "approval_record": null
  },
  "artifacts": {
    "raw_responses": "{{PATH}}",
    "normalized_responses": "{{PATH}}",
    "candidate_resolution": "{{PATH}}",
    "hash_manifest": "{{PATH}}"
  },
  "note": "Design skeleton. Fill in and review before any live run; this file does not call any provider."
}
