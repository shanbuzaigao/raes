{
  "schema_version": "raes-coding-audit/1",
  "version": "0.1.0-draft",
  "production_codebook_version": "{{VERSION}}",
  "canonical_eligibility": {
    "file": "eligibility.json",
    "sha256": "{{EXACT_BYTE_SHA256}}"
  },
  "scope": {
    "frame": "{{FRAME_ID}}",
    "units": "{{ROW_UIDS}}",
    "allowed_domains": [
      "effect-size inputs",
      "pairing and computation path",
      "moderators"
    ],
    "prohibited_actions": [
      "add rows",
      "delete rows",
      "change identity",
      "reopen eligibility",
      "compute downstream effects"
    ]
  },
  "modes": {
    "coding_audit": {
      "inputs": [
        "original frozen rows, effect-size fields blank",
        "sources",
        "production codebook",
        "this audit codebook"
      ],
      "hidden": [
        "the executor's rationale",
        "prior audit output",
        "g",
        "SE_g",
        "CI95_L",
        "CI95_U"
      ],
      "response": [
        "status",
        "checked_Row_UIDs",
        "domains",
        "challenges",
        "unresolved_items"
      ]
    },
    "coding_adjudication": {
      "inputs": [
        "the same original rows and sources",
        "the same production codebook",
        "this same audit codebook",
        "the disputed field only"
      ],
      "hidden": [
        "the auditor's proposed value",
        "the auditor's rationale",
        "the auditor's confidence",
        "downstream effects"
      ],
      "response": [
        "Row_UID",
        "field",
        "independent_value",
        "rule_id",
        "evidence",
        "unresolved_items"
      ]
    }
  },
  "pass_rule": "{{What complete checked coverage and absence of unresolved evidence are required?}}",
  "challenge_rule": "An exact row and field, a source-supported alternative value, a rule ID and a resolvable locator are required.",
  "conflict_rule": "{{Source precedence, or bounded human adjudication; never invent a value}}",
  "error_taxonomy": [
    "technical_invalid",
    "substantive_disagreement",
    "confirmed_correction",
    "unresolved_evidence"
  ],
  "evidence_contract": {
    "source_id": "{{FILENAME_OR_STABLE_SOURCE_ID}}",
    "locator": "{{PAGE_TABLE_LINE_CELL}}",
    "quote_or_data_reference": "{{TRACEABLE_SUPPORT}}"
  }
}
